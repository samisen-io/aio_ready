<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LLM Optimizer</title>
    <% const resolvedBasePath = typeof basePath === 'string' ? basePath : '/llm-optimizer'; %>
    <% const assetsBasePath = typeof assetsPath === 'string' ? assetsPath : `${resolvedBasePath}/assets`; %>
    <link rel="icon" href="<%= assetsBasePath %>/favicon.ico" />
    <link rel="stylesheet" href="<%= assetsBasePath %>/css/site.css" />
  </head>
  <body>
    <main class="app-shell">
      <section class="hero">
        <div class="headline">
          <h1>LLM Optimizer</h1>
          <p>Turn any webpage into rich, AI-ready Schema.org markup.</p>
        </div>
      </section>

      <section class="analyzer">
        <form id="analyzeForm" class="analyze-form" autocomplete="off">
          <label class="form-label" for="url">Page URL</label>
          <div class="form-row">
            <input
              id="url"
              name="url"
              type="url"
              required
              placeholder="https://www.example.com"
            />
            <button type="submit" id="analyzeBtn" class="btn-primary">Analyze</button>
          </div>
        </form>

        <div id="statusCard" class="card status-card">
          <p>Paste a public webpage URL to extract context and generate tailored JSON-LD markup.</p>
        </div>

        <div id="loading" class="card loading hidden">
          <div class="spinner"></div>
          <p>Analyzing page with AI...</p>
        </div>

        <section id="results" class="results hidden">
          <div class="results-grid">
            <article class="result-panel summary-panel">
              <header>
                <h3>Page Snapshot</h3>
              </header>
              <dl class="summary-list">
                <div>
                  <dt>Title</dt>
                  <dd id="summaryTitle">&mdash;</dd>
                </div>
                <div>
                  <dt>Description</dt>
                  <dd id="summaryDescription">&mdash;</dd>
                </div>
                <div>
                  <dt>Detected Business</dt>
                  <dd id="summaryBusiness">&mdash;</dd>
                </div>
                <div>
                  <dt>Contact</dt>
                  <dd>
                    <span id="summaryPhone">&mdash;</span><br />
                    <span id="summaryEmail">&mdash;</span>
                  </dd>
                </div>
                <div>
                  <dt>Prices</dt>
                  <dd>
                    <ul id="summaryPrices" class="pill-list"></ul>
                  </dd>
                </div>
                <div>
                  <dt>Images</dt>
                  <dd>
                    <ul id="summaryImages" class="image-list"></ul>
                  </dd>
                </div>
              </dl>
            </article>
            <article class="result-panel markup-panel">
              <header>
                <h3>Generated Schema Markup</h3>
              </header>
              <pre id="markup"></pre>
              <div class="button-row">
                <button type="button" id="copyBtn" class="btn-secondary">Copy JSON-LD</button>
                <button type="button" id="downloadBtn" class="btn-secondary ghost">Download</button>
              </div>
            </article>
          </div>
        </section>
      </section>
    </main>

    <script src="<%= assetsBasePath %>/js/app.js" defer
      data-base-path="<%= resolvedBasePath %>">
    </script>
  </body>
</html>
