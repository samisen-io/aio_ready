{
  "name": "aio-audit-tool",
  "version": "1.0.0",
  "description": "Website AI Optimization Audit Tool - Analyze your website's readiness for AI agents",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup": "npm install && npm run setup:folders",
    "setup:folders": "mkdir -p public/css public/js public/images views tests/unit tests/integration coverage",
    "pretest": "npm run lint",
    "posttest": "npm run test:coverage"
  },
  "keywords": [
    "AI",
    "SEO",
    "website audit",
    "AI optimization",
    "structured data",
    "web crawler",
    "performance analysis"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "robots-parser": "^3.0.1",
    "validator": "^13.11.0",
    "url-parse": "^1.5.10"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "jsdom": "^23.0.1",
    "nodemon": "^3.0.2",
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-jest": "^27.6.0",
    "identity-obj-proxy": "^3.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "server.js",
      "public/js/**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "verbose": true,
    "collectCoverage": false,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/aio-audit-tool.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/aio-audit-tool/issues"
  },
  "homepage": "https://github.com/yourusername/aio-audit-tool#readme"
}