{
  "name": "aio-audit-tool",
  "version": "1.0.0",
  "description": "Website AI Optimization Audit Tool - Analyze your website's readiness for AI agents",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup": "npm install && npm run setup:folders",
    "setup:folders": "mkdir -p public/css public/js public/images views"
  },
  "keywords": [
    "AI",
    "SEO",
    "website audit",
    "AI optimization",
    "structured data",
    "web crawler",
    "performance analysis"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "robots-parser": "^3.0.1",
    "validator": "^13.11.0",
    "url-parse": "^1.5.10",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samisen-io/aio-audit-tool.git"
  },
  "bugs": {
    "url": "https://github.com/samisen-io/aio-audit-tool/issues"
  },
  "homepage": "https://github.com/samisen-io/aio-audit-tool#readme"
